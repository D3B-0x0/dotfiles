/*
Title: fade
Authors: liixini | https://github.com/liixini 
Desc: imported from https://github.com/liixini/shaders
*/

animations {
   workspace-switch {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }
	horizontal-view-movement {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    exit-confirmation-open-close {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }

    overview-open-close {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    recent-windows-close {
        spring damping-ratio=0.7 stiffness=200 epsilon=0.0001
    }

    window-open {
        duration-ms 500
        curve "ease-out-cubic"
        custom-shader r"
        vec4 open_color(vec3 coords_geo, vec3 size_geo) {
            float p = niri_clamped_progress;
            vec2 uv = coords_geo.xy;

            vec2 center = vec2(0.5, 0.5);
            float scale = mix(0.95, 1.0, p);
            vec2 scaled_uv = (uv - center) / scale + center;

            vec3 tex_coords = niri_geo_to_tex * vec3(scaled_uv, 1.0);
            vec4 color = texture2D(niri_tex, tex_coords.st);

            float alpha = smoothstep(0.0, 0.8, p);

            return color * alpha;
        }
        "
    }

    window-close {
        duration-ms 500
        curve "ease-out-cubic"
        custom-shader r"
        vec4 close_color(vec3 coords_geo, vec3 size_geo) {
            float p = niri_clamped_progress;
            vec2 uv = coords_geo.xy;

            vec2 center = vec2(0.5, 0.5);
            float scale = mix(1.0, 0.95, p);
            vec2 scaled_uv = (uv - center) / scale + center;

            vec3 tex_coords = niri_geo_to_tex * vec3(scaled_uv, 1.0);
            vec4 color = texture2D(niri_tex, tex_coords.st);

            float alpha = smoothstep(1.0, 0.2, p);

            return color * alpha;
        }
        "
    }
}
