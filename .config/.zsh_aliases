# =============================================================================
# ENHANCED FUNCTIONS
# =============================================================================

# Quick open with file type detection
fo() {
    file="$1"
    case "$(file --mime-type -b "$file")" in
        text/*) nvim "$file" ;;
        image/*) feh "$file" ;;
        video/*) mpv "$file" ;;
        application/pdf) zathura "$file" ;;
        *) xdg-open "$file" ;;
    esac
}

# Enhanced compile and run function
run() {
    if [ -z "$1" ]; then
        echo "Usage: run <filename>"
        return 1
    fi

    file="$1"
    ext="${file##*.}"
    name="${file%.*}"

    case "$ext" in
        c)
            clang -Wall -Wextra -pedantic -lm -O2 "$file" -o "$name" && "./$name"
            ;;
        cpp|cc|cxx)
            clang++ -Wall -Wextra -pedantic -O2 -lm  "$file" -o "$name" && "./$name"
            ;;
        rs)
            cargo run
            ;;
        py)
            python3 "$file"
            ;;
        go)
            go run "$file"
            ;;
        sh)
            bash "$file"
            ;;
        js)
            node "$file"
            ;;
        ts)
            ts-node "$file"
            ;;
        *)
            echo "Unsupported file type: $ext"
            return 1
            ;;
    esac
}

# Git clone and cd into directory
gclone() {
    git clone "$1" && cd "$(basename "$1" .git)"
}



# Quick HTTP server with directory listing
httpserver() {
    local port=${1:-8000}
    python3 -m http.server "$port"
}


# Find and kill process by name
killprocess() {
    ps aux | grep -i "$1" | grep -v grep | awk '{print $2}' | xargs kill -9
}

# System information summary
sysinfo() {
    echo "=== System Information ==="
    echo "Hostname: $(hostname)"
    echo "Kernel: $(uname -r)"
    echo "Uptime: $(uptime -p)"
    echo "CPU: $(lscpu | grep 'Model name' | cut -d':' -f2 | xargs)"
    echo "Memory: $(free -h | grep Mem | awk '{print $3"/"$2}')"
    echo "Disk: $(command df -h / | awk 'NR==2 {print $3"/"$2" ("$5" used)"}')"
    echo "Load: $(uptime | awk -F'load average:' '{print $2}')"
    echo "=========================="
}

# =============================================================================
# SECURITY FUNCTIONS
# =============================================================================

# Generate secure password
genpass() {
    local length=${1:-20}
    openssl rand -base64 32 | head -c "$length" && echo
}

# Check if port is open
portcheck() {
    local host=${1:-localhost}
    local port=$2
    nc -z -v "$host" "$port"
}

# Function to encrypt files or directories
encrypt() {
    if [ $# -eq 0 ]; then
        echo "Usage: encrypt <file_or_directory> [output_name]"
        echo "Encrypts and compresses the specified file or directory"
        return 1
    fi

    local input="$1"
    local output="${2:-${input##*/}.gpg}"
    
    if [ ! -e "$input" ]; then
        echo "Error: '$input' does not exist"
        return 1
    fi

    echo "Encrypting '$input'..."
    
    if [ -d "$input" ]; then
        # It's a directory - tar and compress it
        tar czf - "$input" | gpg --symmetric --output "$output"
    else
        # It's a file - compress and encrypt
        gzip -c "$input" | gpg --symmetric --output "$output"
    fi

    if [ $? -eq 0 ]; then
        echo "✓ Successfully encrypted to: $output"
        echo "  Original: $(command du -h "$input" | cut -f1)"
        echo "  Encrypted: $(command du -h "$output" | cut -f1)"
    else
        echo "✗ Encryption failed"
        return 1
    fi
}

# Function to decrypt and extract files
decrypt() {
    if [ $# -eq 0 ]; then
        echo "Usage: decrypt <encrypted_file> [output_directory]"
        echo "Decrypts and extracts the encrypted file"
        return 1
    fi

    local input="$1"
    local output_dir="${2:-.}"
    
    if [ ! -f "$input" ]; then
        echo "Error: '$input' does not exist or is not a file"
        return 1
    fi

    echo "Decrypting '$input'..."
    
    # Try to decrypt and determine if it's a tar archive or single file
    if gpg --decrypt "$input" 2>/dev/null | tar tzf - >/dev/null 2>&1; then
        # It's a tar archive
        gpg --decrypt "$input" | tar xzf - -C "$output_dir"
        if [ $? -eq 0 ]; then
            echo "✓ Successfully decrypted and extracted to: $output_dir"
        else
            echo "✗ Decryption or extraction failed"
            return 1
        fi
    else
        # It's a single compressed file - extract the original filename
        local base_name="${input%.gpg}"
        base_name="${base_name%.gz}"
        local output_file="${output_dir}/${base_name##*/}"
        
        gpg --decrypt "$input" | gunzip > "$output_file" 2>/dev/null
        
        if [ $? -eq 0 ]; then
            echo "✓ Successfully decrypted to: $output_file"
        else
            # Maybe it wasn't gzipped, try direct decryption
            gpg --decrypt "$input" > "$output_file"
            if [ $? -eq 0 ]; then
                echo "✓ Successfully decrypted to: $output_file"
            else
                echo "✗ Decryption failed"
                return 1
            fi
        fi
    fi
}

